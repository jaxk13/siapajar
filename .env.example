# Copy to .env and adjust. Never commit .env or real credentials.

# Server
PORT="3000"
HOST="0.0.0.0"
# NODE_ENV is set by the npm scripts (`npm start` uses production); no need to set it here.

# Optional. Only used by the pre-existing Direct Gemini option, which is not an MVP dependency.
# Leave empty to disable it.
GEMINI_API_KEY=""

# PostgreSQL (local development via docker-compose.dev.yml).
# Set your own password in .env; never commit real credentials.
POSTGRES_USER="siapajar"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="siapajar_dev"
POSTGRES_PORT="5432"

# Connection string for the backend (not used by the app yet; planned for Phase 9).
DATABASE_URL="postgresql://siapajar:CHANGE_ME@localhost:5432/siapajar_dev"
