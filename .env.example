# Copy to .env and adjust. Never commit .env or real credentials.

# Server
PORT="3000"
HOST="0.0.0.0"
# NODE_ENV is set by the npm scripts (`npm start` uses production); no need to set it here.
# Number of proxies in front of the app. Use 1 behind Caddy so rate limiting sees the real client IP.
# Production on the VPS: also set NODE_ENV="production" and HOST="127.0.0.1" (deploy/README.md §5.3).
TRUST_PROXY="0"

# PostgreSQL (local development via docker-compose.yml).
# Set your own password in .env; never commit real credentials.
POSTGRES_USER="siapajar"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="siapajar_dev"
POSTGRES_PORT="5432"

# pgAdmin (database GUI, local development via docker-compose.yml): http://localhost:5050
# Sign in with this email and password. In pgAdmin, the server "SIAPAJAR (local)" is already registered;
# it asks for the database password (POSTGRES_PASSWORD) the first time.
PGADMIN_DEFAULT_EMAIL="admin@siapajar.dev"
PGADMIN_DEFAULT_PASSWORD="CHANGE_ME"
PGADMIN_PORT="5050"

# Connection string used by the backend, migrations, seeder and admin CLI.
# Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL="postgresql://siapajar:CHANGE_ME@localhost:5432/siapajar_dev"

# Secret used to hash access codes (docs/DECISIONS.md ADR-013). Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after codes are issued; changing it invalidates every existing code.
ACCESS_CODE_PEPPER=""

# First super admin for the admin panel (/super-admin), created by `npm run db:seed` or `npm run db:seed:admin`.
# Leave SEED_ADMIN_PASSWORD empty to get a one-time temporary password that must be changed on first sign-in.
# SEED_ADMIN_PASSWORD (min. 10 characters, letters and digits) is for local development only; refused in production.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Admin WhatsApp, shown publicly for questions and payment verification.
# Saved into system_settings by `npm run db:seed`. Example: 081234567890
ADMIN_WHATSAPP=""

# Folder for proof-of-payment files copied by `npm run access:create`. Private: never served publicly.
PAYMENT_PROOF_DIR="storage/payment-proofs"

# Public address of the app, used for links in emails and the payment redirect. No trailing slash.
# Development: http://localhost:3000. Production: https://siapajar.id
APP_URL="http://localhost:3000"

# --- Automatic payment: Midtrans (docs/DECISIONS.md ADR-017) ---
# Leave the keys empty to keep checkout off; the landing page then shows "Beli via WhatsApp".
# Development: use the SANDBOX keys (Midtrans dashboard → Sandbox → Settings → Access Keys).
# Payment notification URL to set in the Midtrans dashboard: <public URL>/api/payment/webhook
# (locally via a tunnel, e.g. ngrok http 3000). Without a tunnel the result page still asks Midtrans for the status.
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# --- Access code email (SMTP) ---
# Development: Mailpit from docker-compose.yml (SMTP_HOST=localhost, SMTP_PORT=1025, no user/password).
#   Every email lands in http://localhost:8025 and never reaches a real inbox.
# Production: SMTP of Resend, Brevo, or another provider (set SMTP_SECURE=true for port 465).
# Leave SMTP_HOST empty to skip sending (recorded as "skipped"; resend later from the admin panel).
EMAIL_FROM="SIAPAJAR <kode@siapajar.id>"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Mailpit ports on this machine (docker-compose.yml).
MAILPIT_SMTP_PORT="1025"
MAILPIT_UI_PORT="8025"

# --- Meta Pixel + Conversions API (ad measurement) ---
# Leave META_PIXEL_ID empty to disable all tracking.
# META_CAPI_TOKEN: Events Manager → your Pixel → Settings → Conversions API → Generate access token.
# META_TEST_EVENT_CODE: Events Manager → Test Events. While set, server events only appear under Test Events.
#   Empty it in production.
META_PIXEL_ID=""
META_CAPI_TOKEN=""
META_TEST_EVENT_CODE=""
META_GRAPH_VERSION="v26.0"
