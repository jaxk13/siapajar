# Copy to .env and adjust. Never commit .env or real credentials.

# Server
PORT="3000"
HOST="0.0.0.0"
# NODE_ENV is set by the npm scripts (`npm start` uses production); no need to set it here.
# Number of proxies in front of the app. Use 1 behind Nginx so rate limiting sees the real client IP.
TRUST_PROXY="0"

# PostgreSQL (local development via docker-compose.yml).
# Set your own password in .env; never commit real credentials.
POSTGRES_USER="siapajar"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="siapajar_dev"
POSTGRES_PORT="5432"

# pgAdmin (database GUI, local development via docker-compose.yml): http://localhost:5050
# Sign in with this email and password. In pgAdmin, the server "SIAPAJAR (local)" is already registered;
# it asks for the database password (POSTGRES_PASSWORD) the first time.
PGADMIN_DEFAULT_EMAIL="admin@siapajar.dev"
PGADMIN_DEFAULT_PASSWORD="CHANGE_ME"
PGADMIN_PORT="5050"

# Connection string used by the backend, migrations, seeder and admin CLI.
# Keep the password in sync with POSTGRES_PASSWORD.
DATABASE_URL="postgresql://siapajar:CHANGE_ME@localhost:5432/siapajar_dev"

# Secret used to hash access codes (docs/DECISIONS.md ADR-013). Required.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never change it after codes are issued; changing it invalidates every existing code.
ACCESS_CODE_PEPPER=""

# First super admin for the admin panel (/super-admin), created by `npm run db:seed` or `npm run db:seed:admin`.
# Leave SEED_ADMIN_PASSWORD empty to get a one-time temporary password that must be changed on first sign-in.
# SEED_ADMIN_PASSWORD (min. 10 characters, letters and digits) is for local development only; refused in production.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Admin WhatsApp, shown publicly for questions and payment verification.
# Saved into system_settings by `npm run db:seed`. Example: 081234567890
ADMIN_WHATSAPP=""

# Folder for proof-of-payment files copied by `npm run access:create`. Private: never served publicly.
PAYMENT_PROOF_DIR="storage/payment-proofs"
